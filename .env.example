# Alpaca Paper Trading API — credential template
# Copy this file to .env and fill in real values. Never commit .env.
#
# Rules (per api_refs_paper_trading.md §2):
#   - Use paper-api.alpaca.markets for trading; data.alpaca.markets for market data
#   - Never mix paper and live credentials
#   - Never hardcode credentials in source files

# --- Paper Trading (default) ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# --- Market Data ---
APCA_DATA_URL=https://data.alpaca.markets

# --- Alpaca MCP Server (tools/alpaca/alpaca-mcp-server) ---
# Consumed by VS Code MCP config (.vscode/mcp.json) and Claude/Cursor configs.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
# Limit MCP tools to specific categories (comma-separated, or omit for all):
# ALPACA_TOOLSETS=account,trading,stock-data,crypto-data,news

# --- Alpaca CLI (tools/alpaca/cli) ---
# CLI reads ALPACA_API_KEY and ALPACA_SECRET_KEY above.
# Set ALPACA_LIVE_TRADE=true only when switching from paper to live.
ALPACA_LIVE_TRADE=false

# --- Go SDK (tools/alpaca/alpaca-trade-api-go) ---
# The Go client reads APCA_API_KEY_ID and APCA_API_SECRET_KEY from env.
# APCA_API_BASE_URL is already set above for paper trading.
